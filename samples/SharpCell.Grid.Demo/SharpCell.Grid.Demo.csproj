<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    The live demo on the documentation site: SpreadsheetView in the browser through WebAssembly.
    Publishing it needs the wasm-tools workload (Skia's native code is linked into dotnet.wasm);
    docs.yml installs it on the runner. A build without the workload compiles but does not run.
  -->
  <PropertyGroup>
    <!-- One framework, so that publish needs no -f: the repository's net8.0;net10.0 is cleared. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SharpCell.Xlsx" />
    <ProjectReference Include="../../src/SharpCell.Grid.Avalonia/SharpCell.Grid.Avalonia.csproj" />
  </ItemGroup>
</Project>
